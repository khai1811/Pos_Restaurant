generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CASHIER
  STAFF
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  BILL_REQUESTED
}

enum OrderStatus {
  PENDING
  PREPARING
  SERVED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  MOMO
  VNPAY
  STRIPE
  SPLIT 
}

enum TransactionStatus {
  SUCCESS
  FAILED
  REFUNDED
}

// Tìm đến model User và sửa lại như sau:
model User {
  id          String   @id @default(uuid())
  fullName    String
  username    String   @unique
  email       String?  @unique
  password    String
  phone       String?
  role        UserRole @default(STAFF)
  isActive    Boolean  @default(true)
  
  pin         String?  
  avatar      String?  
  permissions Json?    

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  menuItems MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Decimal @db.Decimal(12, 2)
  imageUrl    String?
  isAvailable Boolean @default(true)

  popular     Boolean  @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isAvailable])
}

model RestaurantTable {
  id          String      @id @default(uuid())
  tableNumber Int         @unique
  capacity    Int
  status      TableStatus @default(AVAILABLE)

area        String      @default("Sảnh chính")

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Order {
  id String @id @default(uuid())

  tableId String?
table   RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  staffId String
  staff   User @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  status      OrderStatus @default(PENDING)
  totalAmount Decimal    @default(0) @db.Decimal(12, 2)
  note        String?

  orderItems OrderItem[]
  payment    Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tableId])
  @@index([staffId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  menuItemId String?  // Thêm dấu ? để cho phép Null
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
 
  quantity Int
  price    Decimal @db.Decimal(12, 2)
  subtotal Decimal @db.Decimal(12, 2)

// THÊM DÒNG NÀY ĐỂ LƯU TRẠNG THÁI TỪNG MÓN:
  status     String   @default("PENDING")

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([menuItemId])
}

model Payment {
  id String @id @default(uuid())

  orderId String @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  method       PaymentMethod
  totalAmount  Decimal @db.Decimal(12, 2)
  paidAmount   Decimal @db.Decimal(12, 2)
  changeAmount Decimal @db.Decimal(12, 2)

// 🔥 THÊM 2 CỘT NÀY ĐỂ LƯU CHI TIẾT TÁCH KÊNH
  cashAmount     Decimal? @db.Decimal(12, 2)
  transferAmount Decimal? @db.Decimal(12, 2)

  paymentTime DateTime @default(now())

  transactions Transaction[]

  @@index([method])
  @@index([paymentTime])
}

model Transaction {
  id String @id @default(uuid())

  transactionCode String @unique

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  amount Decimal           @db.Decimal(12, 2)
  status TransactionStatus @default(SUCCESS)

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}